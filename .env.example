# MongoDB Atlas URI or replica-set connection string (transactions require a replica set).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
PORT=3000

# Optional absolute path to a Member 1 CommonJS module exporting authenticate.
# When unset, the server uses its Firebase Authentication middleware.
MEMBER1_AUTH_MODULE=

# Required when using the built-in Firebase Authentication middleware.
FIREBASE_PROJECT_ID=<firebase-project-id>
GOOGLE_APPLICATION_CREDENTIALS=<absolute-path-to-service-account-json>
