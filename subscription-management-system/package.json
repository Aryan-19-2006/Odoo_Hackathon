{
  "name": "subscription-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/src/main.ts",
    "worker": "tsx watch worker/src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/main.js",
    "test": "tsx --test server/test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
